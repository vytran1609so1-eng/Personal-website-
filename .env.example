# ---------------------------------------------------------------------------
#  Copy this file to .env.local (for local development) and paste the same
#  three values into Vercel → Settings → Environment Variables when deploying.
#  Never commit .env.local.
#
#  The site runs fine without these — only /admin and the guestbook need them.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API → service_role  (SECRET — server only)
SUPABASE_SERVICE_ROLE_KEY=

# The password you choose for /admin and /guestbook/admin
ADMIN_PASSWORD=
